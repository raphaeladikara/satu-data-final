# Wajib untuk tutor LLM (tanpa ini tutor memakai templat offline)
OPENAI_API_KEY=
# Opsional, bawaan gpt-5.6-luna
OPENAI_MODEL=gpt-5.6-luna
# Wajib di Vercel supaya log tidak hilang. Supabase: Connect > Transaction pooler (port 6543)
# postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Kode untuk membuka dasbor dosen
DOSEN_KEY=
# Garam hash pseudonim NIM (string acak panjang, jangan diganti setelah ada data)
SINAPS_PEPPER=
