{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "hnd1"
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{sinaps/**,server_data/**,corpus/**,public/cases/index.json}",
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,dist/**,src/**,pipeline/**,results/**,public/cases/sub-*/**,.venv/**,.vite/**,.local/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|cases/|brain3d/|hero/|assets/|favicon.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(cases|brain3d|hero)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
